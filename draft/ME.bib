}

@article{coibion_how_2018__dup1,
	title = {How {Do} {Firms} {Form} {Their} {Expectations}? {New} {Survey} {Evidence}},
	volume = {108},
	issn = {0002-8282},
	shorttitle = {How {Do} {Firms} {Form} {Their} {Expectations}?},
	url = {https://www.aeaweb.org/articles?id=10.1257/aer.20151299},
	doi = {10.1257/aer.20151299},
	abstract = {We survey New Zealand firms and document novel facts about their macroeconomic beliefs. There is widespread dispersion in beliefs about past and future macroeconomic conditions, especially inflation. This dispersion in beliefs is consistent with firms' incentives to collect and process information. Using experimental methods, we find that firms update their beliefs in a Bayesian manner when presented with new information about the economy and that changes in their beliefs affect their decisions. Inflation is not generally perceived as being important to business decisions so firms devote few resources to collecting and processing information about inflation.},
	language = {en},
	number = {9},
	urldate = {2024-12-18},
	journal = {American Economic Review},
	author = {Coibion, Olivier and Gorodnichenko, Yuriy and Kumar, Saten},
	month = sep,
	year = {2018},
	keywords = {Belief, Communication, Deflation, Monetary Policy, Firm Behavior: Empirical Analysis, Search, Inflation, Information and Knowledge, Learning, Speculations, Price Level, Unawareness, Expectations},
	pages = {2671--2713},
}

@article{blinder_central_2024__dup1,
	title = {Central {Bank} {Communication} with the {General} {Public}: {Promise} or {False} {Hope}?},
	volume = {62},
	issn = {0022-0515},
	shorttitle = {Central {Bank} {Communication} with the {General} {Public}},
	url = {https://www.aeaweb.org/articles?id=10.1257/jel.20231683},
	doi = {10.1257/jel.20231683},
	abstract = {Central banks are increasingly reaching out to the general public to motivate and explain their monetary policy actions. One major aim of this outreach is to ensure accountability and create trust; another is to guide inflation expectations. This article surveys a rapidly growing literature on central bank communication with the public, rather than with the financial markets. We first discuss why such communication matters and is more challenging than communicating with expert audiences. Then we turn to methods: How do central banks try to reach the public, and do they succeed? Next, and importantly, we survey the empirical evidence on the extent to which this new outreach affects inflation expectations. On balance, we see some promise in the potential to inform the public better, but many challenges along the way.},
	language = {en},
	number = {2},
	urldate = {2024-12-18},
	journal = {Journal of Economic Literature},
	author = {Blinder, Alan S. and Ehrmann, Michael and de Haan, Jakob and Jansen, David-Jan},
	month = jun,
	year = {2024},
	keywords = {Belief, Communication, Deflation, Monetary Policy, Central Banks and Their Policies, Household Finance: Financial Literacy, Inflation, Information and Knowledge, Learning, Search, Speculations, Price Level, Unawareness, Expectations},
	pages = {425--457},
}

