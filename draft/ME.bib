	author = {Ireland, Peter N.},
	month = nov,
	year = {1997},
	keywords = {Monetary policy, Time consistency},
	pages = {87--108},
}

@article{loisel_central_2008,
	title = {Central bank reputation in a forward-looking model},
	volume = {32},
	issn = {0165-1889},
	url = {https://www.sciencedirect.com/science/article/pii/S0165188908000559},
	doi = {10.1016/j.jedc.2008.03.003},
	abstract = {This paper examines whether reputation concerns can induce the central bank to implement the time-inconsistent optimal monetary policy in the standard New Keynesian model. Interestingly, the forward-looking nature of this model enables us to account for the coordination of the private agents on the punishment length of their trigger strategy. Our results suggest that both the inflation bias and the stabilization bias can be overcome by a reputation-concerned central bank for the calibrations used in the literature. These results enable us to endogenize Woodford's timeless perspective and tend to weaken the case for recent monetary policy delegation proposals.},
	number = {11},
	urldate = {2025-03-03},
	journal = {Journal of Economic Dynamics and Control},
	author = {Loisel, Olivier},
	month = nov,
	year = {2008},
	keywords = {Inflation bias, Monetary policy, Reputation, Stabilization bias, Timeless perspective},
	pages = {3718--3742},
}

