	issn = {0025-1909},
	shorttitle = {Information in the {Term} {Structure}},
	url = {https://pubsonline.informs.org/doi/abs/10.1287/mnsc.2020.3715},
	doi = {10.1287/mnsc.2020.3715},
	abstract = {The existing literature finds that information not captured by traditional term structure factors helps predict excess bond returns. When estimating no-arbitrage affine term structure models, aligning in-sample and out-of-sample objective functions results in term structure factors that capture information that remains hidden from existing approaches. Specifically, the estimates of the third term structure factor radically differ and are related to the fourth principal component, which helps forecast bond returns. The new objective function leads to substantial improvements in forecasting performance. It also results in higher model term premiums and lower expected future short rates.

This paper was accepted by David Simchi-Levi, finance.},
