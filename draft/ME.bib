}

@article{moretti_inelastic_nodate,
	title = {Inelastic {Demand} {Meets} {Optimal} {Supply} of {Risky} {Sovereign} {Bonds}},
	abstract = {We present evidence of inelastic demand for risky sovereign bonds and explore its implications for optimal government debt policies. Using monthly changes in the composition of a major international bond index, we identify flow shocks unrelated to fundamentals that shift the available bond supply. From these shocks, we estimate an inverse demand elasticity of -0.30 and show that it increases with countries’ default risk. We formulate a sovereign debt model with endogenous default and inelastic investors, calibrated to our empirical estimates. By penalizing additional borrowing, an inelastic demand acts as a disciplining device that reduces default risk and bond spreads.},
	language = {en},
	author = {Moretti, Matıas and Pandolfi, Lorenzo and Schmukler, Sergio L},
}

@article{mertens_measuring_2016,
	title = {Measuring the {Level} and {Uncertainty} of {Trend} {Inflation}},
	volume = {98},
	issn = {0034-6535},
	url = {https://www.jstor.org/stable/24917126},
	abstract = {Firmly anchored inflation expectations are widely viewed as playing a central role for the conduct of monetary policy. This paper presents estimates of trend inflation, based on information contained in monthly data on realized inflation, survey expectations, and the term structure of interest rates. In order to assess whether inflation expectations are anchored, a time-varying volatility of trend shocks is estimated as well. While there is some commonality in inflation- and survey-based estimates of trend inflation, yield-based trend estimates embed a highly persistent component orthogonal to trend inflation. Trimmed-mean inflation rates and survey forecasts are most indicative of trend inflation.},
	number = {5},
	urldate = {2024-11-26},
