  url = {https://www.sciencedirect.com/science/article/pii/0304393294011668},
  abstract = {This paper presents a theory of the real effects of disinflation. As in New Keynesian models, price adjustment iis staggered across firms. As in New Classical models, credibility is imperfect: the monetary authority may not complete a promised disinflation. The combination of imperfect credibility and staggering yields more plausible results than either of these assumptions alone. In particular, an announced disinflation reduces expected output if credibility is sufficiently low.},
