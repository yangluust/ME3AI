@article{djourelova_media_2024,
	title = {Media {Slant} and {Public} {Policy} {Views}},
	volume = {114},
	issn = {2574-0768, 2574-0776},
	url = {https://pubs.aeaweb.org/doi/10.1257/pandp.20241005},
	doi = {10.1257/pandp.20241005},
	abstract = {We study how exposure to partisan news channels (i.e., Fox News vs. MSNBC) affects individual views on four policy issues — climate change, gun rights, abortion, and immigration. First, using GPT to annotate news transcripts, we document large differences in the way the two networks cover these issues. Second, exploiting exogenous variation in viewership due to channels' positions in cable lineups, we show that exposure to Fox News (MSNBC) is associated with more conservative (progressive) views, even when controlling for self-reported ideology and party affiliation. Our findings indicate that partisan media contribute to the rise of political polarization in the US.},
	language = {en},
	urldate = {2024-12-05},
