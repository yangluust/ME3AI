	month = dec,
	year = {2015},
	keywords = {Business Fluctuations, Corporate Finance and Governance, International Linkages to Development, Cycles, Financial Markets and the Macroeconomy, International Lending and Debt Problems, International Financial Markets, National Debt, Debt Management, Role of International Organizations, Saving and Capital Investment, Sovereign Debt, Economic Development: Financial Markets},
	pages = {3740--3765},
}

@article{hatchondo_debt_2016,
	title = {Debt {Dilution} and {Sovereign} {Default} {Risk}},
	volume = {124},
	issn = {0022-3808},
	url = {https://www.jstor.org/stable/26549904},
	abstract = {We measure the effects of debt dilution on sovereign default risk and study debt covenants that could mitigate these effects. We calibrate a baseline model with endogenous debt duration and default risk (in which debt can be diluted) using data from Spain. We find that debt dilution accounts for 78 percent of the default risk in the baseline economy and that eliminating dilution increases the optimal duration of sovereign debt by almost 2 years. Eliminating dilution also increases consumption volatility but still produces welfare gains. The debt covenants we study could help enforcing fiscal rules.},
	number = {5},
	urldate = {2025-02-27},
	journal = {Journal of Political Economy},
	author = {Hatchondo, Juan Carlos and Martinez, Leonardo and Sosa-Padilla, César},
	year = {2016},
	note = {Publisher: The University of Chicago Press},
	pages = {1383--1422},
}

@article{hatchondo_fiscal_2022,
	title = {Fiscal {Rules} and the {Sovereign} {Default} {Premium}},
	volume = {14},
	issn = {1945-7707},
	url = {https://www.aeaweb.org/articles?id=10.1257/mac.20170479},
	doi = {10.1257/mac.20170479},
	abstract = {We study fiscal rules using a sovereign default model. A debt-brake (spread-brake) rule imposes a ceiling on the fiscal deficit when the sovereign debt (spread) is above a threshold. For our benchmark calibration, similar gains can be achieved with the optimal debt or spread brake. However, for a "Union" of heterogeneous economies, a common spread brake generates larger gains than a common debt brake. Furthermore, gains from abandoning a common debt brake may be significant for economies that are unnecessarily constrained by the rule. In contrast, abandoning a common spread brake would generate losses for any economy in the Union.},
