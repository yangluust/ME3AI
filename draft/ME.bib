@article{ireland_does_1999,
	title = {Does the time-consistency problem explain the behavior of inflation in the {United} {States}?},
	volume = {44},
	issn = {0304-3932},
	url = {https://www.sciencedirect.com/science/article/pii/S0304393299000264},
	doi = {https://doi.org/10.1016/S0304-3932(99)00026-4},
	abstract = {This paper derives the restrictions imposed by Barro and Gordon's theory of time-consistent monetary policy on a bivariate time-series model for inflation and unemployment and tests those restrictions using quarterly US data from 1960 through 1997. The results show that the data are consistent with the implications of the theory for the long-run behavior of the two variables, indicating that the theory can explain the initial rise and subsequent fall of inflation over the past four decades. The results also suggest that the theory must be extended to account more fully for the short-run dynamics that appear in the data.},
	number = {2},
	journal = {Journal of Monetary Economics},
	author = {Ireland, Peter N.},
	year = {1999},
	keywords = {Inflation, Monetary policy, Time-consistency},
	pages = {279--291},
}

