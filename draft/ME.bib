@article{bacchetta_self-fulfilling_2018,
	title = {Self-fulfilling debt crises: {What} can monetary policy do?},
	volume = {110},
	issn = {0022-1996},
	shorttitle = {Self-fulfilling debt crises},
	url = {https://www.sciencedirect.com/science/article/pii/S0022199617301381},
	doi = {10.1016/j.jinteco.2017.11.004},
	abstract = {This paper examines the potential for monetary policy to avoid self-fulfilling sovereign debt crises. We combine a version of the slow-moving debt crisis model proposed by Lorenzoni and Werning (2014) with a standard New Keynesian model. Monetary policy could preclude a debt crisis through raising inflation and output and lowering the real interest rate. These reduce the real value of outstanding debt and the cost of new borrowing, and increase tax revenues and seigniorage. We determine the optimal path of inflation required to avoid a self-fulfilling debt crisis. Stronger price rigidity implies more sustained inflation.},
	urldate = {2025-03-06},
	journal = {Journal of International Economics},
	author = {Bacchetta, Philippe and Perazzi, Elena and van Wincoop, Eric},
	month = jan,
	year = {2018},
