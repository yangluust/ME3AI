@article{chen_exorbitant_nodate,
	title = {Exorbitant {Privilege} {Gained} and {Lost}: {Fiscal} {Implications}},
	abstract = {We study three centuries of U.K., U.S. and Dutch ﬁscal history. When a country is the dominant safe asset supplier, it can issue more debt than what is justiﬁed by its future primary surpluses, even after accounting for seigniorage revenue from convenience yields on the debt. This pattern holds for the Dutch Republic in the 17th and 18th, the U.K. in the 18th and 19th, and the U.S. in the 20th and 21st centuries. When the Dutch Republic’s and the U.K.’s ﬁscal fundamentals deteriorated, they lost their dominant position as the safe asset supplier. After losing their exorbitant privilege, their debt was fully backed by primary surpluses. We conclude that exorbitant privilege derives from the ability to issue overpriced government debt in the early stage, followed by bondholder losses and ﬁnancial repression in the later stage.},
	language = {en},
	journal = {Journal of Political Economy},
	author = {Chen, Zefeng and Jiang, Zhengyang and Lustig, Hanno},
}

