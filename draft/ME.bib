@article{clayton_internationalizing_2025__dup1,
	title = {Internationalizing {Like} {China}},
	volume = {115},
	issn = {0002-8282},
	url = {https://www.aeaweb.org/articles?id=10.1257/aer.20221722},
	doi = {10.1257/aer.20221722},
	abstract = {We empirically characterize how China is internationalizing its bond market by staggering the entry of different types of foreign investors into its domestic market and propose a dynamic reputation model to explain this strategy. Our framework rationalizes China's strategy as trying to build credibility as a safe issuer while reducing the cost of capital flight. We use our framework to shed light on China's response to episodes of capital outflows.},
	language = {en},
	number = {3},
	urldate = {2025-03-31},
	journal = {American Economic Review},
	author = {Clayton, Christopher and Dos Santos, Amanda and Maggiori, Matteo and Schreger, Jesse},
	month = mar,
	year = {2025},
	keywords = {Bond Interest Rates, International Financial Markets, Pension Funds, Capital Controls, Asset Pricing, Corporate Finance and Governance, Socialist Institutions and Their Transitions: Financial Economics, Financial Instruments, Financial Markets and the Macroeconomy, International Financial Policy: Financial Transactions Tax, Institutional Investors, Economic Development: Financial Markets, Non-bank Financial Institutions, Saving and Capital Investment, Trading Volume},
