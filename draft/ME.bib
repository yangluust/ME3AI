@article{kreps_reputation_1982,
	title = {Reputation and imperfect information},
	volume = {27},
	issn = {0022-0531},
	url = {https://www.sciencedirect.com/science/article/pii/0022053182900308},
	doi = {10.1016/0022-0531(82)90030-8},
	abstract = {A common observation in the informal literature of economics (and elsewhere) is that is multistage “games,” players may seek early in the game to acquire a reputation for being “tough” or “benevolent” or something else. But this phenomenon is not observed in some formal game-theoretic analyses of finite games, such as Selten's finitely repeated chain-store game or in the finitely repeated prisoners' dilemma. We reexamine Selten's model, adding to it a “small” amount of imperfect (or incomplete) information about players' payoffs, and we find that this addition is sufficient to give rise to the “reputation effect” that one intuitively expects.},
	number = {2},
	urldate = {2023-11-10},
	journal = {Journal of Economic Theory},
	author = {Kreps, David M and Wilson, Robert},
	month = aug,
	year = {1982},
	pages = {253--279},
}

@article{morelli_information_2023,
	title = {Information {Frictions}, {Reputation}, and {Sovereign} {Spreads}},
	issn = {0022-3808},
	url = {https://www.journals.uchicago.edu/doi/abs/10.1086/724855},
	doi = {10.1086/724855},
	abstract = {We formulate a reputational model in which the type of government is time varying and private information. Agents adjust their beliefs about the government’s type (i.e., reputation) using noisy signals about its policies. We consider a debt repayment setting in which reputation influences the market’s perceived probability of default, which affects sovereign spreads. We focus on the 2007–12 Argentine episode of inflation misreport to quantify how markets price reputation. We find that the misreports significantly increased Argentina’s sovereign spreads. We use those estimates to discipline our model and show that reputation can have long-lasting effects on a government’s borrowing costs.},
	urldate = {2023-11-10},
	journal = {Journal of Political Economy},
	author = {Morelli, Juan M. and Moretti, Matias},
	month = mar,
	year = {2023},
	note = {Publisher: The University of Chicago Press},
	keywords = {Method, notion},
	pages = {000--000},
}

@article{phelan_public_2006,
	title = {Public trust and government betrayal},
	volume = {130},
	issn = {0022-0531},
	url = {https://www.sciencedirect.com/science/article/pii/S0022053105000955},
