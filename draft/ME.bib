}

@article{gati_monetary_2023,
	series = {Inflation: {Drivers} and {Dynamics} 2022},
	title = {Monetary policy \& anchored expectations—{An} endogenous gain learning model},
	volume = {140},
	issn = {0304-3932},
	url = {https://www.sciencedirect.com/science/article/pii/S030439322300082X},
	doi = {10.1016/j.jmoneco.2023.06.009},
	abstract = {Monetary policy is analyzed in a model with a potential unanchoring of inflation expectations. The degree of unanchoring is given by how sensitively the public’s long-run inflation expectations respond to inflation surprises. I find that optimal policy moves the interest rate aggressively when expectations unanchor, allowing the central bank to accommodate inflation fluctuations when expectations are well-anchored. Furthermore, I estimate the model-implied unanchoring process. The data suggest that unanchoring is nonlinear and asymmetric: expectations respond more sensitively to large or downside surprises than to smaller or upside ones.},
	urldate = {2024-04-19},
	journal = {Journal of Monetary Economics},
	author = {Gáti, Laura},
	month = nov,
	year = {2023},
	keywords = {Anchored expectations, Behavioral macro, Monetary policy},
	pages = {S37--S47},
}

@article{bianchi_constrained_2018,
	title = {Constrained {Discretion} and {Central} {Bank} {Transparency}},
	volume = {100},
	issn = {0034-6535},
	url = {https://doi.org/10.1162/REST_a_00659},
	doi = {10.1162/REST_a_00659},
	abstract = {We develop and estimate a general equilibrium model to assess the effects and welfare implications of central bank transparency. Monetary policy can deviate from active inflation stabilization, and agents conduct Bayesian learning about the nature of these deviations. Under constrained discretion, only short deviations occur, agents’ uncertainty about the macroeconomy remains contained, and welfare is high. However, if a deviation persists, uncertainty eventually accelerates and welfare declines. Announcing that inflation stabilization will be temporarily abandoned raises uncertainty. However, these announcements lower policy uncertainty and curb inflationary beliefs at the end of the policy. For the United States, enhancing transparency raises welfare.},
	number = {1},
	urldate = {2024-04-19},
	journal = {The Review of Economics and Statistics},
	author = {Bianchi, Francesco and Melosi, Leonardo},
	month = mar,
	year = {2018},
	pages = {187--202},
}

